package require Tcl 8.6
package require tcltest 2
namespace import ::tcltest::*
package require tclmesh 0.2.0
package require sha256

# Range certificates (src/range.tcl, spec/TclMesh/Range.lean): no
# intermediate of an accepted circuit leaves its word, so wrapped evaluation
# equals exact evaluation; checked profiles enforce it at evaluation.

source [file join [file dirname [info script]] languages exemplars.tcl]

set root [file dirname [file dirname [file normalize [info script]]]]

proc bounded {circuit ranges} {
    dict for {name r} $ranges {
        dict set circuit inputs $name [list cipher int range {*}$r]
    }
    return $circuit
}

proc verdict {circuit {width 32}} {
    tclmesh range check $circuit [tclmesh range emit $circuit $width] $width
}

set bid [dict get [::exemplars::sealed_bid] circuit]
set bounded_bid [bounded $bid {a {0 1000000} b {0 1000000}}]

test R-001-exemplars {least certificates: only subtraction of whole words can overflow} -body {
    lmap e [::exemplars::all] { list [dict get $e name] [verdict [dict get $e circuit]] }
} -result {{sealed-bid {{outside-word ab} {outside-word ba} {outside-word margin}}}\
    {second-price {}} {policy-boolean {}} {policy-arithmetic {}} {set-membership {}}}

test R-002-least-ranges {declared bid ranges propagate through subtraction and select} -body {
    set cert [tclmesh range emit $bounded_bid]
    list [verdict $bounded_bid] [dict get $cert ab] [dict get $cert margin] [dict get $cert clears] \
        [dict get $cert nr]
} -result {{} {-1000000 1000000} {-1000000 1000000} {0 1} {-2147483648 2147483647}}

test R-003-mutations {narrowed, missing, out-of-word and unsupported ranges are rejected} -body {
    set cert [tclmesh range emit $bounded_bid]
    set narrowed [dict replace $cert ab {0 1000000}]
    set missing [dict remove $cert gt]
    set outside [dict replace $cert winner {0 2147483648}]
    set poly [dict get [lindex [::exemplars::all] 0] circuit]
    dict set poly nodes p [tclmesh private node polynomial na {1 2 3}]
    list [tclmesh range check $bounded_bid $narrowed] [tclmesh range check $bounded_bid $missing] \
        [tclmesh range check $bounded_bid $outside] [lsearch -all -inline [verdict $poly] {* p}] \
        [tclmesh range check $poly [dict replace [tclmesh range emit $poly] p {0 0}]]
} -result {{{under-range ab}} {{unranged gt} {unranged-operand winner gt} {unranged-operand margin gt}}\
    {{outside-word winner}} {{unranged p}} {{outside-word ab} {outside-word ba} {outside-word margin}\
    {unsupported p}}}

test R-004-canonical-integers {constants and declared bounds have one spelling} -body {
    lmap k {0 -7 007 +1 -0 0x10 1e3} {
        set c [tclmesh private circuit k {} [dict create y {cipher int}] \
            [dict create y [tclmesh private node constant $k]] \
            [dict create output_nodes [dict create y y]]]
        expr {[verdict $c] eq ""}
    }
} -result {1 1 0 0 0 0 0}

test R-005-narrow-words {the same circuit fits a 32-bit word but not an 8-bit one} -body {
    set signed [bounded $bid {a {-100 100} b {-100 100}}]
    list [verdict $signed 32] [verdict $signed 8] [verdict [bounded $bid {a {0 100} b {0 100}}] 8]
} -result {{} {{outside-word ab} {outside-word ba} {outside-word margin}} {}}

# The upstream corpus (larsbx/finite-math-kernels, UPSTREAM.toml), replayed.
proc pinned {path} {
    set fh [open [file join $::root UPSTREAM.toml] r]
    set toml [read $fh]
    close $fh
    regexp "path = \"$path\"\\s+upstream = \"\[^\"\]+\"\\s+sha256 = \"(\[0-9a-f\]{64})\"" $toml -> sum
    return $sum
}

test R-006-upstream-pin {the vendored word-range corpus is the pinned upstream file} -body {
    set path conformance/word_range_v1.txt
    expr {[::sha2::sha256 -hex -filename [file join $root $path]] eq [pinned $path]}
} -result 1

test R-007-upstream-corpus {interval arithmetic equals finite_exact/word_range.mojo on every row} -body {
    set fh [open [file join $root conformance word_range_v1.txt] r]
    set rows [split [string trimright [read $fh] \n] \n]
    close $fh
    set cell {{text} { expr {$text eq "refused" ? "refused" : [split $text ,]} }}
    set checked 0
    set failures {}
    foreach row $rows {
        set cols [split $row \t]
        switch -- [lindex $cols 0] {
            make {
                lassign $cols - width lo hi want
                set got [tclmesh range op hull $width [list $lo $hi] [list $lo $hi]]
            }
            range {
                lassign $cols - op width a b want
                set operands [list [apply $cell $a]]
                if {$b ne "-"} {
                    lappend operands [apply $cell $b]
                }
                set got [tclmesh range op $op $width {*}$operands]
            }
            default { continue }
        }
        incr checked
        if {$got ne [apply $cell $want]} {
            lappend failures $row
        }
    }
    list [expr {$checked > 1000}] [lrange $failures 0 4]
} -result {1 {}}

# Checked profiles: evaluation admits only accepted circuits on inputs in range.
foreach name {checked-open} {
    if {[catch {tclmesh private profile describe $name}]} {
        tclmesh private profile define $name [dict create \
            backend plaintext semantics int32-checked allow_decrypt true]
    }
}

test R-008-checked-evaluation {an accepted circuit evaluates; its outputs carry certified ranges} -body {
    set h [dict create \
        a [tclmesh private encrypt checked-open int 120 {0 1000000}] \
        b [tclmesh private encrypt checked-open int 95 {0 1000000}]]
    set out [tclmesh private evaluate checked-open $bounded_bid [dict merge $h {reserve 100}]]
    lmap name {winner margin clears} {
        list [tclmesh private decrypt [dict get $out $name]] \
            [dict get [tclmesh private handle describe [dict get $out $name]] range]
    }
} -result {{120 {0 1000000}} {25 {-1000000 1000000}} {1 {0 1}}}

test R-009-overflow-rejected {a circuit that may overflow is not evaluated} -body {
    set h [dict create a [tclmesh private encrypt checked-open int 1] \
        b [tclmesh private encrypt checked-open int 2]]
    catch {tclmesh private evaluate checked-open $bid [dict merge $h {reserve 0}]} - options
    lrange [dict get $options -errorcode] 0 3
} -result {TCLMESH PRIVATE RANGE REJECTED}

proc refusal {script} {
    catch {uplevel 1 $script} - options
    lrange [dict get $options -errorcode] 0 4
}

test R-010-inputs-in-range {values, handles and public inputs outside their ranges are refused} -body {
    set wide [tclmesh private encrypt checked-open int 5]
    set ok [tclmesh private encrypt checked-open int 5 {0 1000000}]
    list \
        [refusal {tclmesh private encrypt checked-open int 2000000 {0 1000000}}] \
        [refusal {tclmesh private encrypt checked-open int 2147483648}] \
        [refusal {tclmesh private encrypt checked-open int 007}] \
        [refusal {tclmesh private evaluate checked-open $bounded_bid [dict create a $wide b $ok reserve 0]}] \
        [refusal {tclmesh private evaluate checked-open $bounded_bid [dict create a $ok b $ok reserve 2147483648]}]
} -result {{TCLMESH PRIVATE RANGE OUT_OF_RANGE encrypt} {TCLMESH PRIVATE RANGE OUT_OF_RANGE encrypt}\
    {TCLMESH PRIVATE RANGE OUT_OF_RANGE encrypt} {TCLMESH PRIVATE RANGE OUT_OF_RANGE a}\
    {TCLMESH PRIVATE RANGE OUT_OF_RANGE reserve}}

test R-011-composition {a certified output feeds a circuit that declares its range} -body {
    set h [dict create \
        a [tclmesh private encrypt checked-open int 7 {0 1000000}] \
        b [tclmesh private encrypt checked-open int 3 {0 1000000}]]
    set margin [dict get [tclmesh private evaluate checked-open $bounded_bid \
        [dict merge $h {reserve 0}]] margin]
    set square [tclmesh private circuit square \
        [dict create x {cipher int range -1000000 1000000}] [dict create y {cipher int}] \
        [dict create nx [tclmesh private node input x] y [tclmesh private node multiply nx nx]] \
        [dict create output_nodes [dict create y y]]]
    set narrow [dict replace $square inputs [dict create x {cipher int range -10 10}]]
    list [lindex [verdict $square] 0] \
        [tclmesh private decrypt [dict get [tclmesh private evaluate checked-open $narrow \
            [dict create x [tclmesh private encrypt checked-open int 4 {-10 10}]]] y]] \
        [refusal {tclmesh private evaluate checked-open $narrow [dict create x $margin]}]
} -result {{outside-word y} 16 {TCLMESH PRIVATE RANGE OUT_OF_RANGE x}}

test R-012-unchecked-profiles {ranges belong to checked profiles of a supported width} -setup {
    if {[catch {tclmesh private profile describe unchecked-open}]} {
        tclmesh private profile define unchecked-open [dict create \
            backend plaintext semantics exact-integer allow_decrypt true]
    }
} -body {
    list [refusal {tclmesh private encrypt unchecked-open int 1 {0 1}}] \
        [refusal {tclmesh private profile define checked-64 [dict create \
            backend plaintext semantics int64-checked]}]
} -result {{TCLMESH PRIVATE RANGE UNCHECKED_PROFILE} {TCLMESH RANGE INVALID_WIDTH 64}}

# Guarded circuits: declared ranges enforced by clamping inside the circuit,
# so the only input hypothesis is what a ciphertext holds (`guarded_sound`).
test R-013-guard-form {guarding declares whole words and clamps the input nodes} -body {
    set g [tclmesh range guard $bounded_bid]
    list [dict get $g inputs a] [dict get $g nodes na] [dict get $g nodes na/raw] [verdict $g] \
        [dict get [tclmesh range emit $g] na]
} -result {{cipher int} {clamp na/raw 0 1000000} {input a} {} {0 1000000}}

test R-014-guarded-evaluation {guarded circuits need no range claim and agree in range} -body {
    set g [tclmesh range guard $bounded_bid]
    lmap {a b} {120 95 2000000 -5} {
        set out [tclmesh private evaluate checked-open $g [dict create \
            a [tclmesh private encrypt checked-open int $a] \
            b [tclmesh private encrypt checked-open int $b] reserve 100]]
        lmap name {winner margin} { tclmesh private decrypt [dict get $out $name] }
    }
} -result {{120 25} {1000000 1000000}}

test R-015-guard-collision {guard refuses to shadow an existing node} -body {
    set c $bounded_bid
    dict set c nodes na/raw [tclmesh private node constant 0]
    refusal {tclmesh range guard $c}
} -result {TCLMESH RANGE GUARD NODE_EXISTS na/raw}

test R-016-clamp-validation {clamp bounds are canonical and ordered} -body {
    lmap bounds {{0 10} {10 0} {007 10} {0}} {
        set c [tclmesh private circuit k [dict create x {cipher int}] [dict create y {cipher int}] \
            [dict create nx [tclmesh private node input x] y [list clamp nx {*}$bounds]] \
            [dict create output_nodes [dict create y y]]]
        expr {![catch {tclmesh private validate $c}]}
    }
} -result {1 0 0 0}

# Review regressions: a descriptor is not evidence of a Boolean value.
proc constant_bool {value} {
    tclmesh private circuit labelled-bit {} {y {cipher bool}} \
        [dict create y [list constant $value]] {output_nodes {y y}}
}
proc bool_successor {} {
    tclmesh private circuit successor {x {cipher bool}} {y {cipher int}} \
        {x {input x} one {constant 1} y {add x one}} {output_nodes {y y}}
}

test R-017-bool-output {a checked circuit cannot label INT_MAX as a bit} -body {
    refusal {tclmesh private evaluate checked-open [constant_bool 2147483647] {}}
} -result {TCLMESH PRIVATE RANGE BOOLEAN_OUTPUT y}

test R-018-bool-input {legacy Boolean-labelled handles cannot bypass the input hypothesis} -body {
    # Reproduce a pre-fix handle, including persisted/imported descriptors.
    set h [tclmesh private encrypt checked-open bool 1]
    set saved [dict get $::tclmesh::private::handles $h]
    set results {}
    foreach range {{2147483647 2147483647} {} {1 0} {bogus 1}} {
        dict set ::tclmesh::private::handles $h range $range
        lappend results [refusal {tclmesh private evaluate checked-open [bool_successor] [dict create x $h]}]
    }
    dict set ::tclmesh::private::handles $h $saved
    set results
} -result {{TCLMESH PRIVATE RANGE OUT_OF_RANGE x} {TCLMESH PRIVATE RANGE OUT_OF_RANGE x} {TCLMESH PRIVATE RANGE OUT_OF_RANGE x} {TCLMESH PRIVATE RANGE OUT_OF_RANGE x}}

test R-019-bool-composition {certified constants 0 and 1 remain bits across handles} -body {
    lmap bit {0 1} {
        set h [dict get [tclmesh private evaluate checked-open [constant_bool $bit] {}] y]
        list [tclmesh private decrypt $h] \
            [tclmesh private decrypt [dict get [tclmesh private evaluate checked-open \
                [bool_successor] [dict create x $h]] y]]
    }
} -result {{0 1} {1 2}}

proc clamp_constant {lo hi} {
    tclmesh private circuit clamp-bounds {} {y {cipher int}} \
        [dict create x {constant 0} y [list clamp x $lo $hi]] {output_nodes {y y}}
}

test R-020-clamp-word-bounds {redundant out-of-word bounds are refused even when the image fits} -body {
    lmap bounds {{-2147483649 10} {-10 2147483648} {-999999999999999999999999 999999999999999999999999}} {
        set c [clamp_constant {*}$bounds]
        list [verdict $c] [refusal {tclmesh private evaluate checked-open $c {}}]
    }
} -result {{{{under-range y}} {TCLMESH PRIVATE RANGE REJECTED {{under-range y}}}} {{{under-range y}} {TCLMESH PRIVATE RANGE REJECTED {{under-range y}}}} {{{under-range y}} {TCLMESH PRIVATE RANGE REJECTED {{under-range y}}}}}

test R-021-clamp-boundary {signed-word endpoints are supported at each width} -body {
    lmap width {2 8 16 32} {
        set word [tclmesh range word $width]
        set good [clamp_constant {*}$word]
        set bad [clamp_constant [expr {[lindex $word 0] - 1}] [lindex $word 1]]
        list [verdict $good $width] [verdict $bad $width]
    }
} -result {{{} {{under-range y}}} {{} {{under-range y}}} {{} {{under-range y}}} {{} {{under-range y}}}}

test R-022-proven-input-statements {proven inputs need a checked profile, a supported width and the word} -setup {
    if {[catch {tclmesh private profile describe unchecked-open}]} {
        tclmesh private profile define unchecked-open [dict create \
            backend plaintext semantics exact-integer allow_decrypt true]
    }
} -body {
    list [refusal {tclmesh private import unchecked-open p.bin ctx 0 8}] \
        [refusal {tclmesh private import checked-open p.bin ctx 0 7}] \
        [refusal {tclmesh private import checked-open p.bin ctx 007 8}] \
        [refusal {tclmesh private import checked-open p.bin ctx 2147483600 8}] \
        [refusal {tclmesh private import checked-open p.bin ctx 0 8}] \
        [refusal {tclmesh private publish checked-open .}]
} -result {{TCLMESH PRIVATE RANGE UNCHECKED_PROFILE} {TCLMESH PRIVATE RANGE INVALID_PROOF_STATEMENT}\
    {TCLMESH PRIVATE RANGE INVALID_PROOF_STATEMENT} {TCLMESH PRIVATE RANGE INVALID_PROOF_STATEMENT}\
    {TCLMESH PRIVATE BACKEND UNSUPPORTED proven-inputs} {TCLMESH PRIVATE BACKEND UNSUPPORTED proven-inputs}}

cleanupTests
