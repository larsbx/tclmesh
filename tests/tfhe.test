package require Tcl 8.6
package require tcltest 2
namespace import ::tcltest::*
package require tclmesh 0.2.0

# Real homomorphic evaluation (backends/tfhe). Runs when the tclmesh-tfhe
# binary is built; the nightly workflow builds it.

testConstraint tfhe [expr {"tfhe" in [tclmesh private backend list]}]

source [file join [file dirname [info script]] languages exemplars.tcl]

if {[testConstraint tfhe]} {
    foreach {name semantics decrypt} {
        tfhe-open int32-wrapping true tfhe-governed int32-wrapping false
        tfhe-checked int32-checked true
    } {
        if {[catch {tclmesh private profile describe $name}]} {
            tclmesh private profile define $name [dict create \
                backend tfhe semantics $semantics allow_decrypt $decrypt]
        }
    }
}

test T-001-exemplars-under-tfhe {decrypted results equal the plaintext reference} -constraints tfhe -body {
    lmap e [::exemplars::all] {
        set run [tclmesh views run tfhe-open [dict get $e circuit] [dict get $e inputs]]
        expr {[dict get $run recipient] eq
            [dict get [tclmesh views declared [dict get $e circuit] [dict get $e inputs]] recipient]}
    }
} -result {1 1 1 1 1}

test T-002-oblivious-traces {real evaluation traces equal the declared view on all pairs} -constraints tfhe -body {
    lmap e [::exemplars::all] {
        tclmesh views paired tfhe-open [dict get $e circuit] [dict get $e inputs] [dict get $e variants]
    }
} -result {{} {} {} {} {}}

test T-003-ciphertext-sizes {ciphertext size does not depend on the plaintext} -constraints tfhe -body {
    set sizes {}
    foreach {type values} {int {0 1 -1 2147483647 -2147483648 4242} bool {0 1}} {
        set seen {}
        foreach v $values {
            set h [tclmesh private encrypt tfhe-open $type $v]
            set token [dict get $::tclmesh::private::handles $h token]
            lappend seen [dict get $token bytes]
            tclmesh private handle destroy $h
        }
        lappend sizes $type [llength [lsort -unique $seen]]
    }
    set sizes
} -result {int 1 bool 1}

test T-004-released-under-tfhe {a 2-of-3 quorum releases the clearing price; direct decryption is forbidden} -constraints tfhe -body {
    tclmesh release use-store {}
    set e [::exemplars::second_price]
    set runtime [dict create \
        a [tclmesh private encrypt tfhe-governed int 120] \
        b [tclmesh private encrypt tfhe-governed int 95]]
    set price [dict get [tclmesh private evaluate tfhe-governed [dict get $e circuit] $runtime] price]
    set direct [catch {tclmesh private decrypt $price}]
    set id [dict get [tclmesh release request $price clearing-price 2 {holder:a holder:b holder:c}] id]
    tclmesh release contribute $id holder:b share-b
    tclmesh release contribute $id holder:c share-c
    list $direct [dict get [tclmesh release combine $id] result]
} -result {1 95}

test T-005-no-exact-integer-claim {TFHE refuses to advertise exact integers unconditionally} -constraints tfhe -body {
    catch {tclmesh private profile define tfhe-exact [dict create \
        backend tfhe semantics exact-integer allow_decrypt true]} - options
    lrange [dict get $options -errorcode] 0 3
} -result {TCLMESH PRIVATE PROFILE BACKEND_REJECTED}

test T-006-wrapping-arithmetic {overflow wraps modulo 2^32, as the profile declares} -constraints tfhe -body {
    set c [tclmesh private circuit wrap \
        [dict create x {cipher int} y {cipher int}] [dict create s {cipher int}] \
        [dict create nx [tclmesh private node input x] ny [tclmesh private node input y] \
            s [tclmesh private node add nx ny]] \
        [dict create output_nodes [dict create s s]]]
    dict get [tclmesh views run tfhe-open $c {x 2147483647 y 1}] recipient
} -result {s -2147483648}

# Checked profiles (src/range.tcl, spec/TclMesh/Range.lean): a circuit is
# evaluated only when no intermediate can leave the 32-bit word, so the
# wrapped result is the exact one.
test T-007-checked-exact {under int32-checked, encrypted results equal the exact reference} -constraints tfhe -body {
    set c [dict get [::exemplars::sealed_bid] circuit]
    foreach name {a b} { dict set c inputs $name {cipher int range 0 1000000} }
    set inputs {a 120 b 95 reserve 100}
    set runtime [dict create \
        a [tclmesh private encrypt tfhe-checked int 120 {0 1000000}] \
        b [tclmesh private encrypt tfhe-checked int 95 {0 1000000}] reserve 100]
    set out [tclmesh private evaluate tfhe-checked $c $runtime]
    set reference [::tclmesh::private::_reference_evaluate $c $inputs]
    lmap name {winner clears margin} {
        expr {[tclmesh private decrypt [dict get $out $name]] eq [dict get $reference $name]}
    }
} -result {1 1 1}

test T-008-checked-overflow {the circuit that wraps under int32-wrapping is refused under int32-checked} -constraints tfhe -body {
    set c [tclmesh private circuit wrap \
        [dict create x {cipher int} y {cipher int}] [dict create s {cipher int}] \
        [dict create nx [tclmesh private node input x] ny [tclmesh private node input y] \
            s [tclmesh private node add nx ny]] \
        [dict create output_nodes [dict create s s]]]
    set runtime [dict create x [tclmesh private encrypt tfhe-checked int 2147483647] \
        y [tclmesh private encrypt tfhe-checked int 1]]
    catch {tclmesh private evaluate tfhe-checked $c $runtime} - options
    lrange [dict get $options -errorcode] 0 3
} -result {TCLMESH PRIVATE RANGE REJECTED}

test T-009-guarded-untrusted {a guarded circuit is exact on ciphertexts nobody vouches for} -constraints tfhe -body {
    set c [dict get [::exemplars::sealed_bid] circuit]
    foreach name {a b} { dict set c inputs $name {cipher int range 0 1000000} }
    set g [tclmesh range guard $c]
    lmap {a b} {120 95 2147483647 -2147483648} {
        set out [tclmesh private evaluate tfhe-checked $g [dict create \
            a [tclmesh private encrypt tfhe-checked int $a] \
            b [tclmesh private encrypt tfhe-checked int $b] reserve 100]]
        set reference [::tclmesh::private::_reference_evaluate $g [dict create a $a b $b reserve 100]]
        lmap name {winner margin} {
            expr {[tclmesh private decrypt [dict get $out $name]] eq [dict get $reference $name]}
        }
    }
} -result {{1 1} {1 1}}

test T-010-checked-bool-handles {bits compose exactly; an integer cannot acquire a Boolean label} -constraints tfhe -body {
    set successor [tclmesh private circuit successor {x {cipher bool}} {y {cipher int}} \
        {x {input x} one {constant 1} y {add x one}} {output_nodes {y y}}]
    set results {}
    foreach bit {0 1} {
        set c [tclmesh private circuit bit {} {y {cipher bool}} \
            [dict create y [list constant $bit]] {output_nodes {y y}}]
        set h [dict get [tclmesh private evaluate tfhe-checked $c {}] y]
        lappend results [tclmesh private decrypt $h] \
            [tclmesh private decrypt [dict get [tclmesh private evaluate tfhe-checked \
                $successor [dict create x $h]] y]]
    }
    dict set c nodes y {constant 2147483647}
    catch {tclmesh private evaluate tfhe-checked $c {}} - opts
    lappend results [dict get $opts -errorcode]
    set results
} -result {0 1 1 2 {TCLMESH PRIVATE RANGE BOOLEAN_OUTPUT y}}

test T-011-checked-clamp-bounds {word endpoints execute exactly; unsupported bounds fail admission} -constraints tfhe -body {
    set c [tclmesh private circuit endpoints {x {cipher int}} {y {cipher int}} \
        {x {input x} y {clamp x -2147483648 2147483647}} {output_nodes {y y}}]
    set results {}
    foreach x {-2147483648 2147483647} {
        set h [tclmesh private encrypt tfhe-checked int $x]
        set out [tclmesh private evaluate tfhe-checked $c [dict create x $h]]
        set exact [::tclmesh::private::_reference_evaluate $c [dict create x $x]]
        lappend results [expr {[tclmesh private decrypt [dict get $out y]] eq [dict get $exact y]}]
    }
    dict set c inputs {}
    dict set c nodes x {constant 0}
    foreach bounds {{-2147483649 10} {-10 2147483648}} {
        dict set c nodes y [list clamp x {*}$bounds]
        catch {tclmesh private evaluate tfhe-checked $c {}} - opts
        lappend results [lrange [dict get $opts -errorcode] 0 3]
    }
    set results
} -result {1 1 {TCLMESH PRIVATE RANGE REJECTED} {TCLMESH PRIVATE RANGE REJECTED}}

# Proven inputs: the encrypting party proves its ciphertext's range with a
# zero-knowledge proof of encryption, using only the published public key and
# CRS; the runtime verifies it and never sees the value.
proc proven {dir context lo bits x args} {
    set out [file join $dir proof-[incr ::proof_seq].bin]
    exec [::tclmesh::tfhe::prover] $dir $context $lo $bits $x $out {*}$args
    return $out
}

if {[testConstraint tfhe]} {
    set zk [file join [::tcltest::temporaryDirectory] tfhe-zk-[pid]]
    file mkdir $zk
    tclmesh private publish tfhe-checked $zk
}

test T-012-proven-exact {proven bids evaluate exactly, unclamped, on their declared ranges} -constraints tfhe -body {
    set c [dict get [::exemplars::sealed_bid] circuit]
    foreach name {a b} { dict set c inputs $name {cipher int range 0 65535} }
    lmap {a b} {120 95 65535 0} {
        set runtime [dict create reserve 100 \
            a [tclmesh private import tfhe-checked [proven $zk auction/a 0 16 $a] auction/a 0 16] \
            b [tclmesh private import tfhe-checked [proven $zk auction/b 0 16 $b] auction/b 0 16]]
        set out [tclmesh private evaluate tfhe-checked $c $runtime]
        set reference [::tclmesh::private::_reference_evaluate $c [dict create a $a b $b reserve 100]]
        lmap name {winner clears margin} {
            expr {[tclmesh private decrypt [dict get $out $name]] eq [dict get $reference $name]}
        }
    }
} -result {{1 1 1} {1 1 1}}

test T-013-proven-handles {a proven handle carries its proved range and origin} -constraints tfhe -body {
    set h [tclmesh private import tfhe-checked [proven $zk ctx -5 8 250] ctx -5 8]
    set d [tclmesh private handle describe $h]
    list [dict get $d origin] [dict get $d range] [tclmesh private decrypt $h]
} -result {proved {-5 250} 250}

test T-014-proof-binding {a proof is refused under another context, offset or width, or once altered} -constraints tfhe -body {
    set proof [proven $zk vote/1 0 8 7]
    set tampered [file join $zk tampered.bin]
    set fh [open $proof rb]; set bytes [read $fh]; close $fh
    set i [expr {[string length $bytes] / 2}]
    binary scan [string index $bytes $i] cu b
    set fh [open $tampered wb]
    puts -nonewline $fh [string replace $bytes $i $i [binary format c [expr {$b ^ 1}]]]
    close $fh
    lmap {file context lo bits} [list $proof vote/2 0 8 $proof vote/1 1 8 $proof vote/1 0 10 $tampered vote/1 0 8] {
        catch {tclmesh private import tfhe-checked $file $context $lo $bits} msg
        string match "*proof rejected*" $msg
    }
} -result {1 1 1 1}

test T-015-proven-range-admission {a proven range wider than the declared one is refused} -constraints tfhe -body {
    set c [dict get [::exemplars::sealed_bid] circuit]
    foreach name {a b} { dict set c inputs $name {cipher int range 0 1000} }
    set h [tclmesh private import tfhe-checked [proven $zk wide 0 16 5] wide 0 16]
    catch {tclmesh private evaluate tfhe-checked $c [dict create a $h b $h reserve 0]} - opts
    lrange [dict get $opts -errorcode] 0 4
} -result {TCLMESH PRIVATE RANGE OUT_OF_RANGE a}

test T-016-honest-prover-refuses {the encrypting party's tool refuses values outside the proven range} -constraints tfhe -body {
    list [catch {proven $zk ctx 0 8 256}] [catch {proven $zk ctx 0 8 -1}] [catch {proven $zk ctx 0 7 1}]
} -result {1 1 1}

test T-017-bounded-proven {an upper bound gives exactly [lo, hi]; the proof is bound to it} -constraints tfhe -body {
    set proof [proven $zk bid -5 8 200 200]
    set h [tclmesh private import tfhe-checked $proof bid -5 8 200]
    list [dict get [tclmesh private handle describe $h] range] [tclmesh private decrypt $h] \
        [catch {tclmesh private import tfhe-checked $proof bid -5 8}] \
        [catch {tclmesh private import tfhe-checked $proof bid -5 8 199}] \
        [catch {proven $zk bid -5 8 201 200}]
} -result {{-5 200} 200 1 1 1}

test T-018-admission-under-tfhe {a released range bit admits in-range inputs and refuses the rest} -constraints tfhe -body {
    tclmesh release use-store {}
    set c [dict get [::exemplars::second_price] circuit]
    foreach name {a b} { dict set c inputs $name {cipher int range 0 200} }
    lmap x {120 230} {
        set h [tclmesh private import tfhe-checked [proven $zk adm/$x 0 8 $x] adm/$x 0 8]
        set ok [tclmesh private range-check tfhe-checked $h 0 200]
        set id [dict get [tclmesh release request $ok admission 2 {holder:a holder:b holder:c}] id]
        tclmesh release contribute $id holder:a s-a
        tclmesh release contribute $id holder:b s-b
        tclmesh release combine $id
        if {[catch {tclmesh private admit $id} - opts]} {
            lindex [dict get $opts -errorcode] 3
        } else {
            set out [tclmesh private evaluate tfhe-checked $c [dict create a $h b $h]]
            list [dict get [tclmesh private handle describe $h] range] \
                [tclmesh private decrypt [dict get $out price]]
        }
    }
} -result {{{0 200} 120} ADMISSION_REFUSED}

if {[testConstraint tfhe]} {
    file delete -force $zk
}

# Leave no TFHE handles behind for tests that persist every live handle.
if {[testConstraint tfhe]} {
    foreach h [tclmesh private handle list] {
        if {![catch {tclmesh private handle describe $h} d] &&
            [dict get $d profile] in {tfhe-open tfhe-governed tfhe-checked}} {
            catch {tclmesh private handle destroy $h}
        }
    }
}

cleanupTests
