module q45_ceremony_bank {
  import q45_ceremony.* from "../../quint/q45_ceremony"

  run inputDuplicateTest = init.then(input(1)).then(input(1).fail())
  run outsiderInputTest = init.then(input(6).fail())
  run prematureSealTest = init.then(seal(1, 0).fail())
  run foreignSealTest = init.then(5.reps(i => input(i + 1))).then(seal(1, 1).fail())
  run missingSealTest = init.then(5.reps(i => input(i + 1)))
    .then(4.reps(i => seal(i + 1, 0))).then(commit(1, 0).fail())
  run duplicateCommitTest = init.then(5.reps(i => input(i + 1)))
    .then(5.reps(i => seal(i + 1, 0))).then(commit(1, 0)).then(commit(1, 0).fail())
  run prematurePartialTest = init.then(5.reps(i => input(i + 1)))
    .then(5.reps(i => seal(i + 1, 0))).then(3.reps(i => commit(i + 1, 0)))
    .then(partial(1, 0, true, true, true).fail())
  run frozenQuorumCannotReformTest = prepared.then(commit(5, 0).fail())
  run deadlineRejectsPartialTest = prepared.then(tick).then(tick)
    .then(partial(1, 0, true, true, true).fail())
  run completedTerminalTest = prepared.then(4.reps(i => partial(i + 1, 0, true, true, true)))
    .then(finish).then(finish.fail())
  run abortedTerminalTest = prepared.then(tick).then(tick).then(expire)
    .then(partial(1, 0, true, true, true).fail())
  run noEarlyExpiryTest = prepared.then(expire.fail())
  run honestCompletionTest = prepared.then(4.reps(i => partial(i + 1, 0, true, true, true)))
    .then(finish).expect(s.phase == 5 and s.recorded == 1 and s.result == 0)
  // Two symbolic offset classes cancel. Correct decoding alone is insufficient.
  run cancellingCorruptionsTest = prepared
    .then(2.reps(i => partial(i + 1, 0, true, true, false)))
    .then(2.reps(i => partial(i + 3, 0, true, true, true)))
    .then(finish).expect(s.phase == 5 and s.result == 0 and s.bad.size() == 2)
  run strictPrepared = initStrict.then(5.reps(i => input(i + 1)))
    .then(5.reps(i => seal(i + 1, 0))).then(4.reps(i => commit(i + 1, 0)))
  run idealRejectsIncorrectTest = strictPrepared.then(partial(1, 0, true, true, false).fail())
  run idealRejectsMalformedTest = strictPrepared.then(partial(1, 0, true, false, true).fail())
  run idealHonestCompletionTest = strictPrepared
    .then(4.reps(i => partial(i + 1, 0, true, true, true))).then(finish)
    .expect(s.phase == 5 and s.result == 0 and strictContract)

  run omit1HonestQuorumTest = init.then(5.reps(i => input(i + 1)))
    .then(5.reps(i => seal(i + 1, 0)))
    .then(commit(2, 0))
    .then(commit(3, 0))
    .then(commit(4, 0))
    .then(commit(5, 0))
    .then(partial(5, 0, true, true, true))
    .then(partial(4, 0, true, true, true))
    .then(partial(3, 0, true, true, true))
    .then(partial(2, 0, true, true, true))
    .then(finish).expect(s.phase == 5 and s.result == 0 and s.quorum == Set(2, 3, 4, 5))

  run omit2HonestQuorumTest = init.then(5.reps(i => input(i + 1)))
    .then(5.reps(i => seal(i + 1, 0)))
    .then(commit(1, 0))
    .then(commit(3, 0))
    .then(commit(4, 0))
    .then(commit(5, 0))
    .then(partial(5, 0, true, true, true))
    .then(partial(4, 0, true, true, true))
    .then(partial(3, 0, true, true, true))
    .then(partial(1, 0, true, true, true))
    .then(finish).expect(s.phase == 5 and s.result == 0 and s.quorum == Set(1, 3, 4, 5))

  run omit3HonestQuorumTest = init.then(5.reps(i => input(i + 1)))
    .then(5.reps(i => seal(i + 1, 0)))
    .then(commit(1, 0))
    .then(commit(2, 0))
    .then(commit(4, 0))
    .then(commit(5, 0))
    .then(partial(5, 0, true, true, true))
    .then(partial(4, 0, true, true, true))
    .then(partial(2, 0, true, true, true))
    .then(partial(1, 0, true, true, true))
    .then(finish).expect(s.phase == 5 and s.result == 0 and s.quorum == Set(1, 2, 4, 5))

  run omit4HonestQuorumTest = init.then(5.reps(i => input(i + 1)))
    .then(5.reps(i => seal(i + 1, 0)))
    .then(commit(1, 0))
    .then(commit(2, 0))
    .then(commit(3, 0))
    .then(commit(5, 0))
    .then(partial(5, 0, true, true, true))
    .then(partial(3, 0, true, true, true))
    .then(partial(2, 0, true, true, true))
    .then(partial(1, 0, true, true, true))
    .then(finish).expect(s.phase == 5 and s.result == 0 and s.quorum == Set(1, 2, 3, 5))

  run omit5HonestQuorumTest = init.then(5.reps(i => input(i + 1)))
    .then(5.reps(i => seal(i + 1, 0)))
    .then(commit(1, 0))
    .then(commit(2, 0))
    .then(commit(3, 0))
    .then(commit(4, 0))
    .then(partial(4, 0, true, true, true))
    .then(partial(3, 0, true, true, true))
    .then(partial(2, 0, true, true, true))
    .then(partial(1, 0, true, true, true))
    .then(finish).expect(s.phase == 5 and s.result == 0 and s.quorum == Set(1, 2, 3, 4))
}
