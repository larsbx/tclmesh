def decimal.compare (a : decimal.Dec) (b : decimal.Dec) : Result Order := do
  let i := alloc.vec.Vec.len a.digits
  let i1 := alloc.vec.Vec.len b.digits
  if i = 0#usize
  then
    if i1 = 0#usize
    then ok Order.Eq
    else if b.negative
         then ok Order.Gt
         else ok Order.Lt
  else
    if i1 = 0#usize
    then if a.negative
         then ok Order.Lt
         else ok Order.Gt
    else
      if a.negative != b.negative
      then if a.negative
           then ok Order.Lt
           else ok Order.Gt
