    | deontic.Verdict.M => ok false
    | deontic.Verdict.K => ok false
    | deontic.Verdict.H => ok false
  | deontic.Verdict.N =>
    match b with
    | deontic.Verdict.W => ok false
    | deontic.Verdict.N => ok true
    | deontic.Verdict.M => ok false
    | deontic.Verdict.K => ok false
    | deontic.Verdict.H => ok false
  | deontic.Verdict.M =>
    match b with
    | deontic.Verdict.W => ok false
    | deontic.Verdict.N => ok false
    | deontic.Verdict.M => ok true
    | deontic.Verdict.K => ok false
    | deontic.Verdict.H => ok false
  | deontic.Verdict.K =>
    match b with
    | deontic.Verdict.W => ok false
    | deontic.Verdict.N => ok false
    | deontic.Verdict.M => ok false
    | deontic.Verdict.K => ok true
    | deontic.Verdict.H => ok false
  | deontic.Verdict.H =>
    match b with
