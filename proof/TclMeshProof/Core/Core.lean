def decimal.magnitude (a : decimal.Dec) (b : decimal.Dec) : Result Order := do
  let i ← lift (IScalar.cast .I64 a.exp)
  let i1 ← lift (UScalar.hcast .I64 a.frac_len)
  let ea ← i - i1
  let i2 ← lift (IScalar.cast .I64 b.exp)
  let i3 ← lift (UScalar.hcast .I64 b.frac_len)
  let eb ← i2 - i3
  let e ← if ea < eb
            then ok ea
            else ok eb
  let s := alloc.vec.Vec.deref a.digits
  let i4 ← ea - e
  let i5 ← lift (IScalar.hcast .U64 i4)
  let s1 := alloc.vec.Vec.deref b.digits
  let i6 ← eb - e
  let i7 ← lift (IScalar.hcast .U64 i6)
